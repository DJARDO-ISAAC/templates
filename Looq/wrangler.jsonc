{
  // "name" must match the Worker name in the Cloudflare dashboard
  "name": "templates",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Built by `npm run build`
    "directory": "./dist",
    // Serves /slug/about from about.html (clean URLs)
    "html_handling": "auto-trailing-slash"
  }
}
